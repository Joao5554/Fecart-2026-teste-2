# Ambiente virtual (cada pessoa cria o seu com: python -m venv .venv)
.venv/

# Cache do Python
__pycache__/
*.pyc

# O modelo treinado (23 MB) VAI para o repositório, de propósito: assim quem
# clonar consegue rodar o sistema na hora, sem baixar a base do Atlas nem
# treinar. É o que permite apresentar o projeto em outro computador com um
# `git clone`. Modelos de teste em outros lugares continuam ignorados.
*.pkl
!modelo/modelo.pkl

# Datasets:
#  - ocorrencias.csv (5 MB) VAI: é o histórico que a API consulta em execução;
#  - dados.csv (24 MB) fica de fora: só serve para treinar e é regenerável;
#  - a base bruta do Atlas (82 MB) fica de fora: é dado de terceiro e pesado.
dados/*.csv
!dados/ocorrencias.csv
dados/bruto/

# Registro de procedência do CSV local: descreve o arquivo de dados de cada
# máquina, então não faz sentido versionar.
dados/procedencia.json

# Cache do pytest
.pytest_cache/

# Pacote para apresentar em outro computador. É gerado por
# ferramentas/preparar_apresentacao.py e contém o modelo treinado.
apresentacao/
apresentacao.zip

# Arquivos do VSCode, do Claude Code e do sistema
.vscode/
.claude/
Thumbs.db
desktop.ini

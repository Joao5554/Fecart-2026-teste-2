# Ambiente virtual (cada pessoa cria o seu com: python -m venv .venv)
.venv/

# Cache do Python
__pycache__/
*.pyc

# Modelo treinado (gerado pelo script de treinamento; arquivo grande)
*.pkl
modelo/metadados.json

# Datasets. Nada de CSV vai para o Git:
#  - a base bruta do Atlas tem 82 MB (acima do limite do GitHub);
#  - dados.csv e ocorrencias.csv são gerados por dados/preparar_dados.py.
# Quem clonar baixa a base bruta uma vez e roda o script.
dados/*.csv
dados/bruto/

# Registro de procedência do CSV local: descreve o arquivo de dados de cada
# máquina, então não faz sentido versionar.
dados/procedencia.json

# Cache do pytest
.pytest_cache/

# Pacote para apresentar em outro computador. É gerado por
# ferramentas/preparar_apresentacao.py e contém o modelo treinado.
apresentacao/
apresentacao.zip

# Arquivos do VSCode, do Claude Code e do sistema
.vscode/
.claude/
Thumbs.db
desktop.ini
